{
  "name": "@energy/pigeon",
  "version": "0.1.0",
  "description": "The deliverability-correct transactional-email + notifications layer — it arrives, in the inbox, not the spam folder.",
  "type": "module",
  "bin": {
    "pigeon": "./dist/cli.js",
    "pigeon-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "src/templates",
    "brain",
    "skills",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "eval": "node dist/eval/eval.js",
    "lint": "tsc --noEmit",
    "runs-view": "node scripts/runs-view.mjs"
  },
  "keywords": [
    "ai",
    "claude",
    "agent",
    "deliverability",
    "transactional-email",
    "resend",
    "react-email",
    "dmarc",
    "spf",
    "dkim",
    "dev-tools"
  ],
  "author": "Energy Platform",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.9",
    "commander": "^13.1.0",
    "react": "19.2.7",
    "resend": "6.14.0",
    "sqids": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
