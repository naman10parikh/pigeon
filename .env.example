# pigeon — environment template. Copy to `.env` (gitignored) and fill.
# pigeon's secret surface only (PLAN §8). Real values never committed.

# ── Provider (default: Resend) ───────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx        # restricted "sending" test key
TRANSACTIONAL_SENDING_DOMAIN=mail.example.com     # your aligned sending subdomain

# ── Test / acceptance ────────────────────────────────────────────────────────
PIGEON_TEST_DOMAIN=example.com                    # CI var; the vendored DNS fixture is the $0 default merge-gate
UNSUBSCRIBE_TOKEN_SECRET=                         # `openssl rand -hex 32` — opaque one-click unsub IDs
RESEND_WEBHOOK_SIGNING_SECRET=                    # required-if-live (bounce/complaint webhook verify)

# ── Alt providers (required only if EMAIL_PROVIDER selects them) ──────────────
# POSTMARK_SERVER_TOKEN=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# SENDGRID_API_KEY=
# NOVU_API_KEY=
# CLOUDFLARE_API_TOKEN=

# ── Inherited platform keys (used by eval L2/L3 judge + E2B sandbox) ──────────
ANTHROPIC_API_KEY=sk-ant-...                      # eval L2/L3 judge (cred-gated when $0)
E2B_API_KEY=e2b_...                               # E2B sandbox boot (cluster E)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...              # MCP github server
